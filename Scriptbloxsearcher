--------------------------------------------------------------------
-- ICON SYSTEM (PNG textures, 3 sources, retries)
--------------------------------------------------------------------
local iconCache = {}   -- name -> content id
local iconFailed = {}  -- name -> true
local iconWaiting = {} -- name -> { {img=, dot=} ... }

local function iconReady(name, content)
	iconCache[name] = content
	for _, w in ipairs(iconWaiting[name] or {}) do
		if w.img and w.img.Parent then
			w.img.Image = content
			if w.dot then w.dot:Destroy() end
		end
	end
	iconWaiting[name] = nil
end

local function loadIcon(name)
	if ICON_ASSETS[name] then
		return iconReady(name, ICON_ASSETS[name])
	end
	if not (httpRequest and hasWrite and hasIsFile and getAsset) then
		iconFailed[name] = true
		return
	end
	local file = ICON_PREFIX .. name .. ".png"
	local function tryAsset()
		local ok, id = pcall(getAsset, file)
		if ok and id then iconReady(name, id) return true end
		return false
	end
	if isfile(file) and tryAsset() then return end
	for _, tpl in ipairs(ICON_CDNS) do
		local url = string.format(tpl, ICON_NAMES[name] or name)
		local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
		if ok and res and res.Body and res.Body:sub(2, 4) == "PNG" then
			pcall(writefile, file, res.Body)
			if tryAsset() then return end
		end
	end
	iconFailed[name] = true
end

for name in pairs(ICON_NAMES) do
	task.spawn(loadIcon, name)
end

-- icon ImageLabel (falls back to a small dot if the texture fails)
local function Icon(parent, name, size, color)
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromOffset(size, size)
	img.ImageColor3 = color or Color3.new(1, 1, 1)
	img.ScaleType = Enum.ScaleType.Fit
	img.Parent = parent

	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromScale(0.4, 0.4)
	dot.BackgroundColor3 = color or Color3.new(1, 1, 1)
	dot.BackgroundTransparency = 0.3
	dot.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = dot
	dot.Parent = img

	if iconCache[name] then
		img.Image = iconCache[name]
		dot:Destroy()
	elseif iconFailed[name] then
		-- keep the dot
	else
		iconWaiting[name] = iconWaiting[name] or {}
		table.insert(iconWaiting[name], { img = img, dot = dot })
	end
	return img
end

local function centerIcon(parent, name, size, color)
	local ic = Icon(parent, name, size, color)
	ic.AnchorPoint = Vector2.new(0.5, 0.5)
	ic.Position = UDim2.fromScale(0.5, 0.5)
	return ic
end

-- icon on the left of a TextLabel/TextButton; UIPadding shifts child origin,
-- so the icon position is compensated by -(padding)
local function decorate(obj, iconName, color, isize, leftPad, rightPad)
	local pad = obj:FindFirstChildOfClass("UIPadding") or new("UIPadding", {}, obj)
	local pl = leftPad + isize + 5
	pad.PaddingLeft = UDim.new(0, pl)
	pad.PaddingRight = UDim.new(0, rightPad or leftPad)
	local ic = Icon(obj, iconName, isize, color)
	ic.Position = UDim2.new(0, leftPad - pl, 0.5, -isize / 2)
	return ic
end

