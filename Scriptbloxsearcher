local function loadSettings()
	if hasIsFile and hasRead and isfile(SETTINGS_FILE) then
		local ok, d = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
		if ok and type(d) == "table" then
			if d.sound ~= nil then S.sound = d.sound and true or false end
			if type(d.volume) == "number" then S.volume = math.clamp(d.volume, 0, 1) end
			if type(d.pack) == "string" and PACKS[d.pack] then S.pack = d.pack end
			if type(d.accent) == "number" and ACCENTS[d.accent] then S.accent = d.accent end
			if d.fx ~= nil then S.fx = d.fx and true or false end
			if type(d.opacity) == "number" then S.opacity = math.clamp(d.opacity, 0.55, 1) end
			if type(d.sort) == "number" and SORTS[d.sort] then S.sort = d.sort end
		end
	end
end
