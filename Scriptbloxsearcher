local function passes(s)
	local f = S.filters
	if f.keyless and s.key then return false end
	if f.key and not s.key then return false end
	if f.verified and not s.verified then return false end
	if f.universal and not s.isUniversal then return false end
	if f.hidePatched and s.isPatched then return false end
	return true
end

