-- API
--------------------------------------------------------------------
local function buildQuery(t)
	local parts = {}
	for k, v in pairs(t) do
		table.insert(parts, k .. "=" .. HttpService:UrlEncode(tostring(v)))
	end
	return table.concat(parts, "&")
end

local function api(path, params)
	if not httpRequest then return nil, "Executor has no HTTP request function" end
	local url = BASE .. path
	if params then url ..= "?" .. buildQuery(params) end
	local ok, res = pcall(httpRequest, {
		Url = url,
		Method = "GET",
		Headers = { ["Accept"] = "application/json" },
	})
	if not ok or not res then return nil, "Request failed" end
	if res.StatusCode and res.StatusCode ~= 200 then
		return nil, "HTTP " .. tostring(res.StatusCode)
	end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not ok2 then return nil, "Bad response" end
	return data
end

