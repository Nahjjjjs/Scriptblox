local function doSearch()
	local q = searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if q == "" then return toast("Type something to search", THEME.orange, "error") end
	if viewing then closeSource() end
	if settingsOpen then
		settingsOpen = false
		setPanel.Visible = false
		setPanel.GroupTransparency = 1
	end
	S.query = q
	S.tab = "search"
	S.page = 1
	sfx("click")
	setTitle("Search Results", 'Results for "' .. q .. '"')
	paintTabs(nil)
	load()
end
