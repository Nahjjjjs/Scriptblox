-- RAIL TABS + SETTINGS OPEN/CLOSE
--------------------------------------------------------------------
local function indicatorPos(id)
	if id == "settings" then
		return UDim2.new(0, 0, 1, GEAR_Y + 11)
	end
	return UDim2.fromOffset(0, TAB_Y0 + (tabIndex[id] - 1) * TAB_STEP + 11)
end

paintTabs = function(activeId)
	for tid, b in pairs(tabButtons) do
		local on = tid == activeId
		tw(b, 0.2, { BackgroundTransparency = on and 0.86 or 1 })
		tw(tabIcons[tid], 0.2, { ImageColor3 = on and THEME.accent or THEME.sub })
	end
	if activeId and (tabIndex[activeId] or activeId == "settings") then
		tw(indicator, 0.3, { Position = indicatorPos(activeId), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
	else
		tw(indicator, 0.2, { BackgroundTransparency = 1 })
	end
end

local function activeTabId()
	if tabIndex[S.tab] then return S.tab end
	return nil
end

local function closeSettings()
	if not settingsOpen then return end
	settingsOpen = false
	local t = tw(setPanel, 0.22, { Position = UDim2.new(0, RAIL, 0, 22), GroupTransparency = 1 })
	t.Completed:Connect(function()
		if not settingsOpen then setPanel.Visible = false end
	end)
	paintTabs(activeTabId())
end

local function openSettings()
	if viewing then closeSource() end
	settingsOpen = true
	sfx("open")
	setPanel.Position = UDim2.new(0, RAIL, 0, 24)
	setPanel.GroupTransparency = 1
	setPanel.Visible = true
	tw(setPanel, 0.32, { Position = UDim2.new(0, RAIL, 0, 0), GroupTransparency = 0 })
	paintTabs("settings")
end

local function setTitle(title, sub)
	titleLbl.Text = title
	titleLbl.TextTransparency = 1
	titleLbl.Position = UDim2.fromOffset(18, 14)
	tw(titleLbl, 0.3, { TextTransparency = 0, Position = UDim2.fromOffset(18, 8) })
	if sub then
		subLbl.Text = sub
		subIcon.Visible = false
		subLbl.Position = UDim2.fromOffset(18, 31)
	else
		subLbl.Text = gameName
		subIcon.Visible = gameIconUrl ~= nil
		subLbl.Position = UDim2.fromOffset(gameIconUrl and 38 or 18, 31)
	end
end

local function setTab(id, silent)
	if viewing then closeSource() end
	if settingsOpen then
		settingsOpen = false
		setPanel.Visible = false
		setPanel.GroupTransparency = 1
	end
	S.tab = id
	S.page = 1
	for _, t in ipairs(TABS) do
		if t.id == id then setTitle(t.label) end
	end
	paintTabs(id)
	if not silent then sfx("tab") end
	load()
end

for i, t in ipairs(TABS) do
	local b, ic = railButton(UDim2.fromOffset(8, TAB_Y0 + (i - 1) * TAB_STEP - 5), t.icon, t.label)
	tabButtons[t.id] = b
	tabIcons[t.id] = ic
	tabIndex[t.id] = i
	b.MouseEnter:Connect(function()
		hoverTick()
		if S.tab ~= t.id or settingsOpen then tw(b, 0.12, { BackgroundTransparency = 0.93 }) end
	end)
	b.MouseLeave:Connect(function()
		local on = (S.tab == t.id) and not settingsOpen
		if not on then tw(b, 0.18, { BackgroundTransparency = 1 }) end
	end)
	b.MouseButton1Click:Connect(function() setTab(t.id) end)
end

-- settings gear (bottom of rail)
do
	local b, ic = railButton(UDim2.new(0, 8, 1, GEAR_Y), "settings", "Settings")
	tabButtons.settings = b
	tabIcons.settings = ic
	b.MouseEnter:Connect(function()
		hoverTick()
		if not settingsOpen then tw(b, 0.12, { BackgroundTransparency = 0.93 }) end
	end)
	b.MouseLeave:Connect(function()
		if not settingsOpen then tw(b, 0.18, { BackgroundTransparency = 1 }) end
	end)
	b.MouseButton1Click:Connect(function()
		if settingsOpen then
			sfx("close")
			closeSettings()
		else
			openSettings()
		end
	end)
end

applyAccent = function()
	THEME.accent = ACCENTS[S.accent].c
	THEME.accentHover = lighten(THEME.accent, 0.12)
	for _, f in ipairs(onAccent) do pcall(f) end
	if settingsOpen then paintTabs("settings") else paintTabs(activeTabId()) end
end

