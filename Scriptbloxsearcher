--------------------------------------------------------------------
-- LOADING SECTIONS
--------------------------------------------------------------------
local load

local function sortable(tab)
	return tab == "game" or tab == "universal" or tab == "search"
end

local function serverParams(extra)
	local p = { page = S.page, max = PER_PAGE }
	local f = S.filters
	if f.keyless then p.key = 0 end
	if f.key then p.key = 1 end
	if f.verified then p.verified = 1 end
	if f.universal then p.universal = 1 end
	if f.hidePatched then p.patched = 0 end
	p.sortBy = SORTS[S.sort].field
	p.order = "desc"
	for k, v in pairs(extra or {}) do p[k] = v end
	return p
end

local function fetchSection()
	local tab = S.tab
	local data, err

	if tab == "saved" then
		return saved, 1
	elseif tab == "game" then
		data, err = api("/api/script/search", serverParams({ q = searchName }))
	elseif tab == "universal" then
		data, err = api("/api/script/search", serverParams({ q = "universal", universal = 1 }))
	elseif tab == "trending" then
		data, err = api("/api/script/trending", nil)
	elseif tab == "latest" then
		data, err = api("/api/script/fetch", { page = S.page, max = PER_PAGE })
	elseif tab == "popular" then
		data, err = api("/api/script/fetch", { page = S.page, max = PER_PAGE, sortBy = "views", order = "desc" })
	elseif tab == "search" then
		data, err = api("/api/script/search", serverParams({ q = S.query }))
	end

	if not data or not data.result then return nil, err or "No data" end
	local scripts = data.result.scripts or data.result.script or {}
	if tab == "popular" then
		table.sort(scripts, function(a, b) return (a.views or 0) > (b.views or 0) end)
	end
	return scripts, data.result.totalPages or 1
end

local function sortList(arr)
	local field = SORTS[S.sort].field
	table.sort(arr, function(a, b)
		if S.tab == "game" then
			local am, bm = a._match and 1 or 0, b._match and 1 or 0
			if am ~= bm then return am > bm end
		end
		local av, bv = a[field], b[field]
		if field == "createdAt" then
			return tostring(av or "") > tostring(bv or "")
		end
		return (tonumber(av) or 0) > (tonumber(bv) or 0)
	end)
end

load = function()
	S.token += 1
	local my = S.token
	clearList()
	hideEmpty()
	setLoading(true)
	showSkeleton()
	pageLbl.Text = "Page " .. S.page
	sortBtn.Visible = sortable(S.tab)

	task.spawn(function()
		local scripts, totalOrErr = fetchSection()
		if my ~= S.token then return end

		if not scripts then
			clearList()
			setLoading(false)
			showEmpty("Couldn't load scripts", tostring(totalOrErr) .. "\nCheck your connection and executor HTTP support.", "patched")
			sfx("error")
			return
		end
		S.totalPages = tonumber(totalOrErr) or 1

		local out = {}
		for _, s in ipairs(scripts) do
			if passes(s) then
				if s.game and tostring(s.game.gameId) == tostring(placeId) then s._match = true end
				table.insert(out, s)
			end
		end
		if sortable(S.tab) then sortList(out) end

		clearList()
		setLoading(false)
		if #out == 0 then
			showEmpty("No scripts found", "Try other filters, another sort or a different section.", "search")
			return
		end

		hideEmpty()
		list.CanvasPosition = Vector2.new(0, 0)
		for i, s in ipairs(out) do
			if my ~= S.token then return end
			makeCard(s, i)
			if i <= 4 then task.delay((i - 1) * 0.06, sfx, "build") end
			if i % 6 == 0 then task.wait() end
		end
		pageLbl.Text = string.format("Page %d / %d", S.page, S.totalPages)
	end)
end

