	btn.MouseEnter:Connect(function()
		local ap = (btn.AbsolutePosition - main.AbsolutePosition) / scale.Scale
		local sz = btn.AbsoluteSize / scale.Scale
		tipLbl.Text = text
		if side == "right" then
			tipLbl.AnchorPoint = Vector2.new(0, 0.5)
			tipLbl.Position = UDim2.fromOffset(ap.X + sz.X + 8, ap.Y + sz.Y / 2)
		else
			tipLbl.AnchorPoint = Vector2.new(0.5, 1)
			tipLbl.Position = UDim2.fromOffset(ap.X + sz.X / 2, ap.Y - 6)
		end
		tipLbl.Visible = true
		tipLbl.TextTransparency = 1
		tipLbl.BackgroundTransparency = 1
		tw(tipLbl, 0.12, { TextTransparency = 0, BackgroundTransparency = 0 })
	end)
	btn.MouseLeave:Connect(function() tipLbl.Visible = false end)
	btn.MouseButton1Down:Connect(function() tipLbl.Visible = false end)
end

-- hover + press effects (base/hover can be a Color3 or a THEME key like "accent")
local function interactive(btn, base, hover)
	btn.AutoButtonColor = false
	btn.BackgroundColor3 = col(base)
	local sc = new("UIScale", {}, btn)
	btn.MouseEnter:Connect(function()
		hoverTick()
		tw(btn, 0.12, { BackgroundColor3 = col(hover) })
	end)
	btn.MouseLeave:Connect(function()
		tw(btn, 0.18, { BackgroundColor3 = col(base) })
		tw(sc, 0.12, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function() tw(sc, 0.07, { Scale = 0.93 }) end)
	btn.MouseButton1Up:Connect(function() tw(sc, 0.2, { Scale = 1 }, Enum.EasingStyle.Back) end)
	if type(base) == "string" or type(hover) == "string" then
		table.insert(onAccent, function() btn.BackgroundColor3 = col(base) end)
	end
end

