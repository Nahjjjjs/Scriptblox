local function fmt(n)
	n = tonumber(n) or 0
	if n >= 1000000 then return string.format("%.1fM", n / 1000000) end
	if n >= 1000 then return string.format("%.1fK", n / 1000) end
	return tostring(n)
end

-- "2h ago" from an ISO date string
local function ago(iso)
	if type(iso) ~= "string" then return nil end
	local ok, dt = pcall(function() return DateTime.fromIsoDate(iso) end)
	if not ok or not dt then return nil end
	local d = os.time() - dt.UnixTimestamp
	if d < 0 then d = 0 end
	if d < 60 then return "just now" end
	if d < 3600 then return math.floor(d / 60) .. "m ago" end
	if d < 86400 then return math.floor(d / 3600) .. "h ago" end
	if d < 86400 * 30 then return math.floor(d / 86400) .. "d ago" end
	if d < 86400 * 365 then return math.floor(d / (86400 * 30)) .. "mo ago" end
	return math.floor(d / (86400 * 365)) .. "y ago"
end

