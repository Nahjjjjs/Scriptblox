			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Image = ICON_ASSETS.logo, ScaleType = Enum.ScaleType.Fit,
		}, holder)
		return holder
	end

	local page = new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ClipsDescendants = true,
	}, holder)
	corner(page, 4)
	grad(page, Color3.fromRGB(140, 156, 255), Color3.fromRGB(84, 102, 225))

	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(20, 0),
		Size = UDim2.fromOffset(10, 10), Rotation = 45,
		BackgroundColor3 = maskColor, BorderSizePixel = 0,
	}, page)
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(16.5, 3.5),
		Size = UDim2.fromOffset(5, 5), Rotation = 45,
		BackgroundColor3 = Color3.fromRGB(190, 200, 255), BorderSizePixel = 0,
	}, page)

	local function line(yy, w)
		local l = new("Frame", {
			Position = UDim2.fromOffset(4, yy), Size = UDim2.fromOffset(w, 2),
			BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.1,
			BorderSizePixel = 0,
		}, page)
		corner(l, 1)
	end
	line(9, 12)
	line(14, 12)
	line(19, 8)
	return holder
end

