local function bar(parent, w, h, rot, ox, oy, color)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, ox or 0, 0.5, oy or 0),
		Size = UDim2.fromOffset(w, h), Rotation = rot or 0,
