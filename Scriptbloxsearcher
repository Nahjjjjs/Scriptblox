local function openSource(s)
	viewing = s
	sfx("open")
	srcTitle.Text = s.title or "Script source"
	srcCode.Text = "Loading source..."
	srcNums.Text = ""
	srcInfo.Text = ""
	srcScroll.CanvasPosition = Vector2.new(0, 0)
	srcPanel.Position = UDim2.new(0, RAIL, 0, 24)
	srcPanel.GroupTransparency = 1
	srcPanel.Visible = true
	tw(srcPanel, 0.32, { Position = UDim2.new(0, RAIL, 0, 0), GroupTransparency = 0 })

	task.spawn(function()
		local code = getCode(s)
		if viewing ~= s then return end
		if not code then
			srcCode.Text = "Couldn't get the script source."
			return
		end

		code = code:gsub("\r", "")
		local total = #code
		local shown = code
		local truncated = false
		if total > MAX_PREVIEW then
			shown = code:sub(1, MAX_PREVIEW)
			truncated = true
		end

		local _, nl = shown:gsub("\n", "")
		local lines = nl + 1
		local nums = table.create(lines)
		for i = 1, lines do nums[i] = tostring(i) end

		srcNums.Text = table.concat(nums, "\n")
