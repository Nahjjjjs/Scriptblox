--------------------------------------------------------------------
-- SCRIPT ACTIONS
--------------------------------------------------------------------
local function getCode(s)
	if s.script and s.script ~= "" then return s.script end
	if s.slug then
		local d = api("/api/script/" .. s.slug)
		local code = d and d.script and d.script.script
		if code then s.script = code return code end
	end
	return nil
end

local function runScript(s)
	toast("Loading " .. (s.title or "script") .. "...")
	task.spawn(function()
		local code = getCode(s)
		if not code then return toast("Couldn't get script code", THEME.red, "error") end
		if not loadStr then return toast("Executor has no loadstring", THEME.red, "error") end
		local fn, err = loadStr(code)
		if not fn then return toast("Compile error: " .. tostring(err):sub(1, 40), THEME.red, "error") end
		local ok, e = pcall(fn)
		if ok then
			if s.key then
				toast("Executed (key script, you may need a key)", THEME.orange, "success")
			else
				toast("Executed!", THEME.green, "success")
			end
		else
			toast("Runtime error: " .. tostring(e):sub(1, 40), THEME.red, "error")
		end
	end)
end

local function copyScript(s)
	task.spawn(function()
		local code = getCode(s)
		if not code then return toast("Couldn't get script code", THEME.red, "error") end
		if setClip then
			setClip(code)
			toast("Script copied!", THEME.green, "success")
		else
			toast("Executor has no setclipboard", THEME.red, "error")
		end
	end)
end

