-- tween helper (animations off -> sets values instantly)
local function tw(o, t, props, style, dir)
	if not S.fx then
		for k, v in pairs(props) do pcall(function() o[k] = v end) end
		return {
			Cancel = function() end,
			Completed = { Connect = function(_, f) task.defer(f) end },
		}
	end
	local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

