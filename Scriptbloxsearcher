	bar(parent, 12, 2, 45, 0, 0, color)
	bar(parent, 12, 2, -45, 0, 0, color)
end
local function drawMinus(parent, color)
	bar(parent, 11, 2, 0, 0, 0, color)
end
local function drawChevron(parent, dir, color)
	if dir == "right" then
		bar(parent, 7, 2, 45, -1, -2, color)
		bar(parent, 7, 2, -45, -1, 2, color)
	else
		bar(parent, 7, 2, -45, 1, -2, color)
		bar(parent, 7, 2, 45, 1, 2, color)
	end
end

